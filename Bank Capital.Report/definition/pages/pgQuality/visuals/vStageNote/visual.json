            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why stage 2 is on the page",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#0A0917",
                      "fontWeight": "bold"
                    }
                  }
                ]
