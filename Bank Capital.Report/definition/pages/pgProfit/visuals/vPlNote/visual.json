                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each quarter's profit is the year-to-date figure less the same bank's previous quarter, within that bank's own financial year - one bank closes its year in June, and resetting everyone in January would make its numbers nonsense.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Where the previous quarter is missing the quarter is left blank, not guessed: the first quarter in the file, a bank's first quarter in the panel, and three banks that only report their P&L half-yearly.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Full-year figures need none of that, which is why the headline uses them.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              }
            ]
          }
