              {
                "textRuns": [
                  {
                    "value": "How the quarters were taken apart",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#0A0917",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
