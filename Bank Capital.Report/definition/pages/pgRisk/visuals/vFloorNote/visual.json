                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "CRR3 puts a floor under internally modelled risk weights: from 2025 a bank's RWAs cannot fall below 50% of the standardised figure, rising to 72.5% by 2030.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The 2025 exercise publishes RWAs before and after the floor. At the 50% starting level it binds on one bank, and the sector-wide cost is a rounding error.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The floor is phased so that it bites later. Density is the column to watch: the banks with the lightest risk weights are where it will land.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
